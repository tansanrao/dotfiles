  "buffer_line_height": "standard",
  "diff_view_style": "split",
  "language_models": {
    "openai_compatible": {
      "Virginia Tech": {
        "api_url": "https://llm-api.arc.vt.edu/api",
        "available_models": [
          {
            "name": "Kimi-K3",
            "max_tokens": 128000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 128000,
            "reasoning_effort": "low",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          }
        ]
      }
    }
  },
  "format_on_save": "modifications_if_available",
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "mode": "auto",
        "model": "opus[1m]"
      },
      "type": "registry"
    },
    "amp-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6-astra",
        "mode": "agent",
        "collaboration_mode": "default",
        "reasoning_effort": "medium",
        "fast-mode": true
      },
      "type": "registry"
    }
  },
  "restore_on_startup": "launchpad",
  "prettier": {
    "allowed": false
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle",
    "provider": "copilot"
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "www.cs.umb.edu",
        "www.vldb.org",
        "www.microsoft.com",
        "www.postgresql.org",
        "api.crossref.org",
        "docs.ebpf.io"
      ]
    },
    "default_profile": "write",
    "default_model": {
      "speed": "fast",
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "button": true,
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "button": true
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "bold_folder_labels": true,
    "dock": "left"
  },
  "icon_theme": "Zed (Default)",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": true,
            "forwardSearchAfter": true
          },
          "forwardSearch": {
            "executable": "/Applications/Skim.app/Contents/SharedSupport/displayline",
            "args": ["-g", "-r", "%l", "%p", "%f"]
          }
        }
      }
    },
    "tinymist": {
      "initialization_options": {
        // Enable background preview
        // Server will be running on 127.0.0.1:23635
        "preview": {
          "background": {
            "enabled": true,
          }
        },
      },
      "settings": {
        // Compile on save
        // This will compile a PDF for the `main.typ` file in the project root.
        "exportPdf": "onSave",
        "outputPath": "$root/$name",
        // Enable formatter
        "formatterMode": "typstyle",
        "formatterProseWrap": true,
        "formatterPrintWidth": 80
      }
    }
  },

}
